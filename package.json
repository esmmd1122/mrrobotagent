{
  "name": "mr.robot-agent",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:vercel": "node scripts/vercel-build.mjs",
    "postinstall": "prisma generate",
    "start": "next start",
    "test:salon": "node --experimental-strip-types --test src/modules/salon/scheduling.test.ts src/lib/env/production.test.ts && node scripts/salon-conflict.mjs && node scripts/salon-isolation.mjs",
    "test:commerce": "node --experimental-strip-types --test src/modules/commerce/pricing.test.ts src/modules/commerce/money.test.ts src/modules/commerce/product-pricing.test.ts src/modules/commerce/order-access.test.ts src/modules/commerce/purchase-fields.test.ts src/modules/commerce/redirect-to-payment.test.ts src/modules/commerce/plan-pricing.test.ts src/modules/commerce/display-price.test.ts src/modules/commerce/error-messages.test.ts src/modules/commerce/origin-safety.test.ts",
    "test:payment": "node --experimental-strip-types --test src/modules/payment/environment.test.ts src/modules/payment/payment-integrity.test.ts src/modules/payment/initiate-body.test.ts src/modules/payment/labels.test.ts",
    "test:fulfillment": "node --experimental-strip-types --test src/modules/fulfillment/rules.test.ts src/modules/fulfillment/file-download.test.ts",
    "test:customer": "node --experimental-strip-types --test src/lib/customer-auth/session.test.ts src/lib/customer-auth/cookie-options.test.ts src/lib/delivery/storage-path.test.ts src/lib/delivery/read-stored-bytes.test.ts src/modules/customer-auth/enumeration.test.ts src/modules/commerce/customer-order-access.test.ts src/modules/notifications/notification-access.test.ts",
    "test:store": "npm run test:commerce && npm run test:payment && npm run test:fulfillment && npm run test:customer",
    "test:assistant": "node --experimental-strip-types --test src/modules/ai/mrrobot-assistant.test.ts src/components/cinema/engine/character/assistant-state.test.ts",
    "backup:sqlite": "node scripts/backup-sqlite.mjs",
    "migrate:postgres": "node scripts/migrate-sqlite-to-postgres.mjs",
    "check:prisma-schemas": "node scripts/check-prisma-schemas.mjs",
    "generate:postgres": "prisma generate --schema=prisma/schema.postgresql.prisma",
    "test:migrate-scripts": "node --test scripts/lib/db-write-guard.test.mjs scripts/lib/sqlite-table-order.test.mjs scripts/lib/sqlite-backup-core.test.mjs scripts/lib/pg-migrate-core.test.mjs scripts/lib/parse-prisma-schema.test.mjs scripts/lib/compare-prisma-schemas.test.mjs",
    "migrate:fulfillment-files": "node scripts/migrate-fulfillment-files.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.0.0",
    "@ai-sdk/react": "^1.0.0",
    "@aws-sdk/client-s3": "^3.716.0",
    "@neon/config": "^1.14.2",
    "@neon/env": "^2.1.5",
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/three": "^0.187.0",
    "ai": "^4.0.0",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^11.15.0",
    "gsap": "^3.15.1",
    "ioredis": "^5.4.2",
    "jose": "^6.2.17",
    "lucide-react": "^1.77.0",
    "next": "16.3.4",
    "openai": "^7.62.0",
    "pg": "^8.13.1",
    "prisma": "^5.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1",
    "three": "^0.187.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.0.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
