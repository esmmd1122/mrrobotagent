# Copy to .env — never commit .env
DATABASE_URL="file:./dev.db"

# Required for admin sessions (32+ characters)
AUTH_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# One-time seed (run: npx prisma db seed)
ADMIN_SEED_EMAIL="admin@mrrobot.local"
ADMIN_SEED_PASSWORD=""

# Optional — salon chat demo only
OPENAI_API_KEY=""

# Salon SaaS OTP. Local only. Never set true in production.
OTP_DEV_REVEAL="true"
# SMS_PROVIDER_URL=""
# SMS_PROVIDER_TOKEN=""
# GEMINI_API_KEY=""

# Production only. Do not point local DATABASE_URL at Postgres until the copy script succeeds.
# POSTGRES_URL="postgresql://user:pass@host:5432/mrrobot"
# REDIS_URL="redis://default:pass@host:6379"
# S3_BUCKET=""
# S3_REGION="auto"
# S3_ENDPOINT=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL=""
