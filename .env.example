# Copy to .env — never commit .env or real credentials.

# --- Local development (default) ---
# SQLite file database; unchanged from existing workflow.
DATABASE_URL="file:./dev.db"

# Required for admin sessions (32+ characters; not the placeholder below in production).
AUTH_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# One-time seed (run: npx prisma db seed)
ADMIN_SEED_EMAIL="admin@mrrobot.local"
ADMIN_SEED_PASSWORD=""

# Optional — salon chat demo only
OPENAI_API_KEY=""

# Salon SaaS OTP. Local only. Never set true in production.
OTP_DEV_REVEAL="true"
# SMS_PROVIDER_URL=""
# SMS_PROVIDER_TOKEN=""
# GEMINI_API_KEY=""

# --- Neon / Vercel production (PostgreSQL) ---
# DATABASE_URL — pooled connection for the running app (Prisma Client at runtime, Vercel).
# Use the Neon *pooler* host in production serverless; include sslmode=require.
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
#
# DIRECT_URL — non-pooled direct connection for Prisma CLI when DATABASE_URL is pooled
# (e.g. db push against prisma/schema.postgresql.prisma). Same user/db as DATABASE_URL, direct host.
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
#
# POSTGRES_URL — direct connection used only by npm run migrate:postgres (data copy).
# Do not use the pooler URL for long transactions. Not read by the Next.js app.
# POSTGRES_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
#
# Store-only production: homepage + commerce without Redis/S3 until those services are ready.
# MR_ROBOT_STORE_ONLY="true"
#
# Full production (salon/studio OTP, media uploads) also needs:
# REDIS_URL="redis://default:pass@host:6379"
# S3_BUCKET=""
# S3_REGION="auto"
# S3_ENDPOINT=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL=""